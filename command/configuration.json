{
  "id": "atlas-command",
  "version": "1.0.0",
  "engine": "container-command",
  "image": "PLACEHOLDER_ATLAS_COMMAND_IMAGE_PINNED_BY_DIGEST",
  "commands": {
    "check-page": ["node", "/opt/atlas/command/check-page.mjs"],
    "verify": ["node", "/opt/atlas/command/verify.mjs"],
    "transfer": ["node", "/opt/atlas/command/transfer.mjs"],
    "publish-index": ["node", "/opt/atlas/command/publish-index.mjs"],
    "withdraw": ["node", "/opt/atlas/command/withdraw.mjs"]
  },
  "parameters": {
    "ATLAS_HEAD_SHA": { "pattern": "[0-9a-f]{40}", "required": false },
    "ATLAS_PAGE": { "pattern": "counties/[A-Za-z0-9_-][A-Za-z0-9._-]*/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json", "required": false },
    "ATLAS_COUNTY": { "pattern": "[A-Z]{2}/[a-z0-9]+(?:-[a-z0-9]+)*", "required": false },
    "ATLAS_MAIN_SHA": { "pattern": "[0-9a-f]{40}", "required": false },
    "ATLAS_GATEWAY_DEADLINE_MINUTES": { "pattern": "[1-9][0-9]{0,2}", "required": false }
  },
  "secretEnvironment": {
    "ATLAS_DEPLOY_KEY": "secretsmanager:transform/commands/atlas/deploy-key",
    "FILEBASE_ACCESS_KEY": "secretsmanager:transform/commands/atlas/filebase-access-key",
    "FILEBASE_SECRET_KEY": "secretsmanager:transform/commands/atlas/filebase-secret-key",
    "ATLAS_GATEWAYS": "secretsmanager:transform/commands/atlas/gateways",
    "ATLAS_GATEWAY_TOKEN": "secretsmanager:transform/commands/atlas/gateway-token"
  },
  "inputs": [{ "name": "held.json", "required": false }],
  "outputs": [
    { "name": "result.json", "required": true },
    { "name": "held.json", "required": false },
    { "name": "validation-errors.csv", "required": false }
  ],
  "limits": {
    "cpu": 4096,
    "memoryMiB": 16384,
    "ephemeralStorageGiB": 50,
    "timeoutMinutes": 360
  }
}
