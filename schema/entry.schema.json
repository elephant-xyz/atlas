{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/elephant-xyz/atlas/schema/entry.schema.json",
  "title": "Atlas county page",
  "description": "One page per county: every run ever published for it, newest last, and a `latest` pointer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["county", "state", "fips", "latest", "runs"],
  "properties": {
    "county": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "lowercase kebab-case county key" },
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "fips": { "type": "string", "pattern": "^[0-9]{5}$" },
    "latest": { "$ref": "#/definitions/runId", "description": "run id of the run consumers should read; must exist and must not be withdrawn" },
    "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/run" } }
  },
  "definitions": {
    "runId": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]{1,8}$" },
    "cid": { "type": "string", "pattern": "^b[a-z2-7]{50,}$", "description": "CIDv1, base32" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "county_root", "blocks", "properties", "cli", "lexicon", "node", "evidence", "status"],
      "properties": {
        "run": { "$ref": "#/definitions/runId" },
        "county_root": { "$ref": "#/definitions/cid", "description": "CID of the CountyIndex block rooting the county CAR" },
        "tables_root": { "$ref": "#/definitions/cid", "description": "CID of the CountyTables block rooting the Parquet part set; absent for archive-only runs" },
        "blocks": { "type": "integer", "minimum": 1 },
        "properties": { "type": "integer", "minimum": 0 },
        "parts": { "type": "integer", "minimum": 1 },
        "cli": { "$ref": "#/definitions/sha", "description": "elephant-cli commit that produced the run" },
        "lexicon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_url"],
          "properties": {
            "manifest_url": { "type": "string", "pattern": "^https://" },
            "cid": { "$ref": "#/definitions/cid" }
          }
        },
        "node": { "type": "string", "minLength": 1, "description": "`filebase` or a named node" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "car_upload": { "type": "string", "minLength": 1 },
            "tables_upload": { "type": "string", "minLength": 1 },
            "validation": { "type": "string", "minLength": 1 }
          }
        },
        "status": { "enum": ["published", "superseded", "withdrawn"] }
      }
    }
  }
}
