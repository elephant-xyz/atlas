{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/elephant-xyz/atlas/schema/v1/entry.schema.json",
  "title": "Atlas county page",
  "description": "The current state of one county: one archive per data group. History lives in git.",
  "type": "object",
  "additionalProperties": false,
  "required": ["county", "state", "fips", "groups"],
  "properties": {
    "county": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "lowercase kebab-case county key" },
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "fips": { "type": "string", "pattern": "^[0-9]{5}$" },
    "groups": {
      "type": "object",
      "description": "data-group key (`county`, `property_improvement`, ...) to the archive published for it; empty means nothing is published",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cid", "schema", "tables"],
          "properties": {
            "cid": { "$ref": "#/definitions/cid", "description": "CountyIndex root of the archive" },
            "schema": { "$ref": "#/definitions/cid", "description": "CID of the data-group schema from the lexicon manifest that the archive's properties carry" },
            "tables": { "$ref": "#/definitions/cid", "description": "CountyTables root written by export-tables for this archive" }
          }
        }
      }
    }
  },
  "definitions": {
    "cid": { "type": "string", "pattern": "^b[a-z2-7]{50,}$", "description": "CIDv1, base32" }
  }
}
